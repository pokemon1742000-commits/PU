{
  "name": "doi-chieu-du-lieu",
  "version": "1.0.27",
  "description": "Ứng dụng đối chiếu dữ liệu mua hàng, quét mã và nhập kho",
  "repository": {
    "type": "git",
    "url": "https://github.com/pokemon1742000-commits/PU.git"
  },
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "prestart": "npm run rebuild:electron",
    "prestart:desktop": "npm run rebuild:electron",
    "start": "electron .",
    "start:desktop": "electron .",
    "pretest": "npm run rebuild:node",
    "rebuild:node": "node scripts/rebuild-native.js node",
    "rebuild:electron": "node scripts/rebuild-native.js electron",
    "test": "node --test test/data-audit.test.js test/exporter.test.js test/file-runner.test.js test/native-runtime.test.js test/processor.test.js test/self-check.test.js test/storage.test.js test/storage-migration.test.js test/update-release.test.js test/ui.test.js",
    "verify": "node scripts/self-check.js",
    "check": "node --check main.js && node --check preload.js && node --check src/processor.js && node --check src/file-worker.js && node --check src/exporter.js && node --check src/storage.js && node --check src/data-audit.js && node --check src/self-check.js && node --check src/update-release.js && node --check renderer/app.js && node --check scripts/self-check.js && node --check scripts/rebuild-native.js && node --check scripts/guide-preload.js && node --check scripts/generate-guide-images.js",
    "dist": "electron-builder --win portable",
    "publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish.ps1",
    "release:auto": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-auto.ps1"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "fuzzball": "^2.2.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "vn.doichieu.desktop",
    "productName": "Đối Chiếu Dữ Liệu",
    "compression": "store",
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/app-logo.png",
      "assets/guide-*.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/MKAC Monthly Timesheet.xlsx",
        "to": "assets/MKAC Monthly Timesheet.xlsx"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/app-logo.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Doi-Chieu-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "pokemon1742000-commits",
      "repo": "PU",
      "releaseType": "release"
    }
  },
  "allowScripts": {}
}
